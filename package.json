{
  "name": "notebook-live-edit-mcp",
  "displayName": "Notebook Live Edit MCP",
  "description": "MCP server that lets AI coding agents read, edit and run cells in the notebook open in VS Code, using its live kernel.",
  "version": "0.1.1",
  "publisher": "bwehlin",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bwehlin/nbliveedit"
  },
  "bugs": {
    "url": "https://github.com/bwehlin/nbliveedit/issues"
  },
  "homepage": "https://github.com/bwehlin/nbliveedit#readme",
  "categories": [
    "Notebooks",
    "AI",
    "Data Science"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "notebook",
    "ipynb",
    "jupyter",
    "claude code",
    "agent"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Notebook Live Edit MCP",
      "properties": {
        "notebookLiveEdit.port": {
          "type": "number",
          "default": 7337,
          "description": "Port for the MCP HTTP server (bound to 127.0.0.1). Reload window after changing."
        }
      }
    },
    "commands": [
      {
        "command": "notebookLiveEdit.addTo.claude",
        "title": "Add MCP Server to Claude Code",
        "category": "Notebook Live Edit MCP"
      },
      {
        "command": "notebookLiveEdit.addTo.codex",
        "title": "Add MCP Server to Codex",
        "category": "Notebook Live Edit MCP"
      }
    ]
  }
}
